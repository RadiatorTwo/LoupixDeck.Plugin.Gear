<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- LoupixDeck.PluginSdk and LoupixDeck.RenderKit come from nuget.org. The local RenderKit feed
       covers the window before a new RenderKit version is indexed there. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LoupixDeck.RenderKit (local)" value="..\LoupixDeck.RenderKit\nupkg" />
  </packageSources>
</configuration>
